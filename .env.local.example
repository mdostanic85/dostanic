# Required — public values used by both Studio and the read-only client.
# Find these at https://www.sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional — pin the GROQ API version. Defaults to 2024-10-01 if unset.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional — Studio URL used in CMS-aware links. Defaults to /studio.
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Server-only read token. Required later when previewing drafts.
SANITY_API_READ_TOKEN=

# Editor token — only needed to run the seed script (scripts/seed-sanity.ts).
# Create at: sanity.io/manage → API → Tokens → Add API token (Editor).
SANITY_API_WRITE_TOKEN=
